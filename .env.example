# ===== 安溯·知源 VeriTrace 环境变量模板 =====
# 复制为 .env 后按实际填写；未填写的变量使用 application.yml 中的默认值。

# 数据库配置
DB_USERNAME=root
DB_PASSWORD=123456

# 外部 AI 服务（通义千问 / 阿里云百炼 DashScope）
# 留空时 AI 问答自动降级为规则文案，页面其余功能不受影响
AI_API_KEY=

# 模型配置（一般无需修改）
AI_AGENT_MODEL=qwen-plus
AI_VL_MODEL=qwen3-vl-plus
AI_EMBEDDING_MODEL=text-embedding-v3

# 应用基础地址：生成二维码溯源链接使用
# 本机演示用 http://localhost:8080；手机扫码改为宿主机局域网 IP，如 http://192.168.1.8:8080
APP_BASE_URL=http://localhost:8080
